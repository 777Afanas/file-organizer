{
  "name": "file-organizer",
  "version": "1.0.0",
  "description": "CLI tool to organize files",
  "main": "file-organizer.js",
  "type": "module",
  "scripts": {
    "generate-test": "node generate-test-files.js",
    "dev:scan": "nodemon file-organizer.js scan ./test-directory",
    "dev:duplicates": "nodemon file-organizer.js duplicates ./test-directory",
    "dev:organize": "node file-organizer.js organize ./test-directory --output ./Organized",
    "dev:cleanup": "nodemon file-organizer.js cleanup ./test-directory --older-than 90"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10"
  }
}
